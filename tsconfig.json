{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "server.ts",
    "misstep/**/*.ts",
    "datasets/**/*.ts",
    "eval/**/*.ts",
    "agent/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
